CONFIG_IDF_TARGET="esp32s3"

# Flash e partizioni
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU e ottimizzazione
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Console: USB-Serial-JTAG finché TinyUSB non prende la PHY
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FAT: nomi lunghi su heap, UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Niente PSRAM su questa variante
CONFIG_SPIRAM=n

CONFIG_FREERTOS_HZ=1000

# TinyUSB: tutte le classi compilate, il profilo sceglie quali esporre
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# Web HID: WebSocket nel server HTTP
CONFIG_HTTPD_WS_SUPPORT=y
